<!DOCTYPE html>
<html lang="en">
<head>
    <title>Smiling Moon Farm</title>
    <link href="~/css/layout.css" rel="stylesheet"/>
    <link rel="stylesheet" href="~/SmilingMoonFarmWeb.styles.css" />
</head>
<body>
<div class="container">
    <div class="navbar">
        <a href="/"><div class="navbar-brand">Smiling Moon Farm</div></a>
        <ul class="navbar-links">
            <li><a href="/">Home</a></li>
            <li><a href="/shop">Shop</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/contact">Contact</a></li>
        </ul>
        <div class="navbar-icon-section">
            <a href="/cart">
                <img src="~/shopping_cart.svg" alt="" width="24"/>
                <span id="cart-item-count">0</span>
            </a>
            <div id="mobileMenu" class="mobile-menu" onclick="onMenuClick()">
                <img src="~/menu_24dp.svg" alt="" width="32"/>
            </div>
        </div>
        <!-- Mobile menu links -->
        <ul class="mobile-menu-links" id="mobileMenuLinks" style="">
            <li><a href="/">Home</a></li>
            <li><a href="/shop">Shop</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/contact">Contact</a></li>
        </ul>
    </div>
    <div class="page-container">
        <div class="page-content">
            @RenderBody()
        </div>
        <div id="loading-overlay-id" class="loading-overlay" style="display: none">
            <div class="loading-spinner"></div>
        </div>

    </div>
    
    <footer class="footer">
        <div class="copyright">Copyright © 2025 Smiling Moon Farm - All Rights Reserved.</div>
    </footer>
</div>
</body>
</html>